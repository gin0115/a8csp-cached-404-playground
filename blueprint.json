{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "A8csp Cached 404 Page test site",
		"description": "WordPress with WooCommerce, sample products and A8csp Cached 404 Page as a must-use plugin.",
		"author": "gin0115"
	},
	"landingPage": "/wp-admin/options-general.php?page=a8csp-cached-404",
	"preferredVersions": {
		"php": "8.4",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "woocommerce"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "query-monitor"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "polylang"
			},
			"options": {
				"activate": false
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "translatepress-multilingual"
			},
			"options": {
				"activate": false
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/woocommerce/woocommerce/trunk/plugins/woocommerce/sample-data/sample_products.xml"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php\nrequire '/wordpress/wp-load.php';\ndelete_transient( '_wc_activation_redirect' );\n$profile = (array) get_option( 'woocommerce_onboarding_profile', array() );\n$profile['completed'] = true;\nupdate_option( 'woocommerce_onboarding_profile', $profile );\nupdate_option( 'woocommerce_coming_soon', 'no' );\nupdate_option( 'woocommerce_store_pages_only', 'no' );\nupdate_option( 'woocommerce_task_list_hidden_lists', array( 'setup', 'extended' ) );\nupdate_option( 'woocommerce_task_list_completed_lists', array( 'setup' ) );\n"
		},
		{
			"step": "unzip",
			"zipFile": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/gin0115/a8csp-cached-404-playground/main/a8csp-cached-404-page.zip"
			},
			"extractToPath": "/wordpress/wp-content/mu-plugins"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/a8csp-cached-404-page-loader.php",
			"data": "<?php\n\\defined( 'ABSPATH' ) || exit;\n\nrequire_once WPMU_PLUGIN_DIR . '/a8csp-cached-404-page/a8csp-cached-404-page.php';\n"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/a8csp-test-links.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/gin0115/a8csp-cached-404-playground/main/mu-plugins/a8csp-test-links.php"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php\nrequire '/wordpress/wp-load.php';\n$GLOBALS['wp_rewrite']->set_permalink_structure( '/%postname%/' );\nflush_rewrite_rules();\n"
		}
	]
}
